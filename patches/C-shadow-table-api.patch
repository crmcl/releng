 #define GUM_QUICK_TYPE_INVOCATION_LISTENER \
     (gum_quick_invocation_listener_get_type ())
@@ -166,6 +167,10 @@ static void gum_quick_replace_entry_revert_and_free (
     GumQuickReplaceEntry * entry);
 GUMJS_DECLARE_FUNCTION (gumjs_interceptor_revert)
 GUMJS_DECLARE_FUNCTION (gumjs_interceptor_flush)
+GUMJS_DECLARE_FUNCTION (gumjs_interceptor_enable_shadow)
+GUMJS_DECLARE_FUNCTION (gumjs_interceptor_register_shadow)
+GUMJS_DECLARE_FUNCTION (gumjs_interceptor_remove_shadow)
+GUMJS_DECLARE_FUNCTION (gumjs_interceptor_shadow_enabled)
 
 GUMJS_DECLARE_FUNCTION (gumjs_invocation_listener_detach)
 static void gum_quick_invocation_listener_dispose (GObject * object);
@@ -278,6 +283,10 @@ static const JSCFunctionListEntry gumjs_interceptor_entries[] =
   JS_CFUNC_DEF ("_replaceFast", 0, gumjs_interceptor_replace_fast),
   JS_CFUNC_DEF ("revert", 0, gumjs_interceptor_revert),
   JS_CFUNC_DEF ("flush", 0, gumjs_interceptor_flush),
+  JS_CFUNC_DEF ("_enableShadow", 0, gumjs_interceptor_enable_shadow),
+  JS_CFUNC_DEF ("_registerShadow", 0, gumjs_interceptor_register_shadow),
+  JS_CFUNC_DEF ("_removeShadow", 0, gumjs_interceptor_remove_shadow),
+  JS_CFUNC_DEF ("_shadowEnabled", 0, gumjs_interceptor_shadow_enabled),
 };
 
 static const JSClassDef gumjs_invocation_listener_def =
@@ -775,6 +784,59 @@ GUMJS_DEFINE_FUNCTION (gumjs_interceptor_flush)
   return JS_UNDEFINED;
 }
 
+GUMJS_DEFINE_FUNCTION (gumjs_interceptor_enable_shadow)
+{
+  const gchar * superkey;
+
+  if (!_gum_quick_args_parse (args, "s", &superkey))
+    return JS_EXCEPTION;
+
+  if (!gum_yszint_shadow_init (superkey))
+  {
+    _gum_quick_throw_literal (ctx,
+        "failed to enable shadow: KPM not reachable");
+    return JS_EXCEPTION;
+  }
+
+  return JS_UNDEFINED;
+}
+
+GUMJS_DEFINE_FUNCTION (gumjs_interceptor_register_shadow)
+{
+  gpointer address;
+  GBytes * bytes;
+  gconstpointer data;
+  gsize size;
+  gboolean success;
+
+  if (!_gum_quick_args_parse (args, "pB", &address, &bytes))
+    return JS_EXCEPTION;
+
+  data = g_bytes_get_data (bytes, &size);
+
+  success = gum_yszint_shadow_register (address, data, (guint) size);
+
+  return JS_NewBool (ctx, success);
+}
+
+GUMJS_DEFINE_FUNCTION (gumjs_interceptor_remove_shadow)
+{
+  gpointer address;
+  gboolean success;
+
+  if (!_gum_quick_args_parse (args, "p", &address))
+    return JS_EXCEPTION;
+
+  success = gum_yszint_shadow_unregister (address);
+
+  return JS_NewBool (ctx, success);
+}
+
+GUMJS_DEFINE_FUNCTION (gumjs_interceptor_shadow_enabled)
+{
+  return JS_NewBool (ctx, gum_yszint_shadow_is_enabled ());
+}
+
 GUMJS_DEFINE_FUNCTION (gumjs_invocation_listener_detach)
 {
   GumQuickInterceptor * parent;
