 bindings/gumjs/runtime/core.js       |  24 ++
 gum/gumyszintshadow.c                | 319 +++++++++++++++++++++++++++
 gum/gumyszintshadow.h                |  77 +++++++
 gum/meson.build                      |   2 +
 meson.build                          |   2 +-
 6 files changed, 485 insertions(+), 1 deletion(-)
 create mode 100644 gum/gumyszintshadow.c
 create mode 100644 gum/gumyszintshadow.h

