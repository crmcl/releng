diff --git a/gum/gumyszintshadow.c b/gum/gumyszintshadow.c
new file mode 100644
index 00000000..75bff89e
--- /dev/null
+++ b/gum/gumyszintshadow.c
@@ -0,0 +1,319 @@
+/*
+ * yszint Shadow Table Integration — v2
+ * Copyright (C) 2026 yszint. All Rights Reserved.
+ *
+ * Direct supercall interface to KernelPatch for shadow memory registration.
+ * Replaces v1's fork/exec approach with a single syscall per operation.
+ */
+
+#include "gumyszintshadow.h"
+
+#ifdef HAVE_LINUX
+#include <unistd.h>
+#include <sys/syscall.h>
+#include <stdio.h>
+#include <string.h>
+
+/*
+ * KernelPatch supercall interface constants.
+ * From: https://github.com/bmax121/KernelPatch/blob/main/kernel/patch/include/uapi/scdefs.h
+ */
+#define KP_NR_SUPERCALL        45
+#define KP_SUPERCALL_HELLO     0x1000
+#define KP_SUPERCALL_KP_VER    0x1008
+#define KP_SUPERCALL_KPM_CONTROL 0x1022
+#define KP_SUPERCALL_HELLO_MAGIC 0x11581158
+
+/* KPM module name for ctl0 commands */
+#define YSZINT_KPM_NAME "yszint-stealth"
+
+/* Output buffer for ctl0 responses */
+#define CTL0_OUT_SIZE 256
+
+/* State — protected by shadow_mutex */
+static GMutex shadow_mutex;
+static gboolean shadow_initialized = FALSE;
+static gboolean shadow_enabled = FALSE;
+static gchar *shadow_superkey = NULL;
+static guint32 kp_version = 0;
+
+/*
+ * Build the ver_and_cmd argument for supercall.
+ * Format: ((version << 32) | (0x1158 << 16) | (cmd & 0xFFFF))
+ *
+ * The 0x1158 magic in bits 16-31 identifies KernelPatch supercalls.
+ * Version in bits 32-63 must be compatible with the kernel-side KP.
+ */
+static inline long
+kp_ver_and_cmd (long cmd)
+{
+  return ((long) kp_version << 32) | (0x1158L << 16) | (cmd & 0xFFFF);
+}
+
+/*
+ * Issue a raw KernelPatch supercall.
+ * Returns the syscall return value.
+ */
+static inline long
+kp_supercall (long cmd, long a3, long a4, long a5, long a6)
+{
+  return syscall (KP_NR_SUPERCALL,
+      shadow_superkey,
+      kp_ver_and_cmd (cmd),
+      a3, a4, a5, a6);
+}
+
+/*
+ * Send a ctl0 command to the yszint-stealth KPM.
+ * Returns TRUE if the command was accepted (syscall return >= 0).
+ */
+static gboolean
+kpm_ctl0 (const gchar * command, gchar * out_buf, glong out_len)
+{
+  long ret;
+
+  ret = kp_supercall (KP_SUPERCALL_KPM_CONTROL,
+      (long) YSZINT_KPM_NAME,
+      (long) command,
+      (long) out_buf,
+      out_len);
+
+  return (ret >= 0);
+}
+
+/*
+ * Convert a byte buffer to a lowercase hex string.
+ * Caller must free with g_free().
+ */
+static gchar *
+bytes_to_hex (const guint8 * data, guint len)
+{
+  gchar * hex;
+  guint i;
+
+  hex = g_malloc (len * 2 + 1);
+  for (i = 0; i < len; i++)
+    sprintf (hex + i * 2, "%02x", data[i]);
+  hex[len * 2] = '\0';
+
+  return hex;
+}
+
+/*
+ * Probe KernelPatch presence and discover version.
+ * Returns TRUE if KP is installed and responding.
+ */
+static gboolean
+detect_kernelpatch (void)
+{
+  long ret;
+
+  /* Try hello with a guessed version first. Use 0x000a06 (KP 0.10.6). */
+  kp_version = 0x000a06;
+
+  ret = kp_supercall (KP_SUPERCALL_HELLO, 0, 0, 0, 0);
+  if (ret == (long) KP_SUPERCALL_HELLO_MAGIC)
+    goto have_kp;
+
+  /* Some KP versions may use different version encoding. Try 0x000a05. */
+  kp_version = 0x000a05;
+  ret = kp_supercall (KP_SUPERCALL_HELLO, 0, 0, 0, 0);
+  if (ret == (long) KP_SUPERCALL_HELLO_MAGIC)
+    goto have_kp;
+
+  /* Try with version 0 — some kernel-side handlers may be lenient. */
+  kp_version = 0;
+  ret = kp_supercall (KP_SUPERCALL_HELLO, 0, 0, 0, 0);
+  if (ret == (long) KP_SUPERCALL_HELLO_MAGIC)
+    goto have_kp;
+
+  return FALSE;
+
+have_kp:
+  {
+    /*
+     * Now that we have a working version, try to get the real KP version
+     * and use it for subsequent calls.
+     */
+    long ver;
+
+    ver = kp_supercall (KP_SUPERCALL_KP_VER, 0, 0, 0, 0);
+    if (ver > 0 && ver < 0xFFFFFF)
+      kp_version = (guint32) ver;
+
+    return TRUE;
+  }
+}
+
+gboolean
+gum_yszint_shadow_init (const gchar * superkey)
+{
+  gboolean result;
+  gchar out_buf[CTL0_OUT_SIZE];
+
+  if (superkey == NULL || superkey[0] == '\0')
+    return FALSE;
+
+  g_mutex_lock (&shadow_mutex);
+
+  /* Store superkey (allow re-init with new key) */
+  g_free (shadow_superkey);
+  shadow_superkey = g_strdup (superkey);
+  shadow_enabled = FALSE;
+  shadow_initialized = TRUE;
+
+  /* Verify KernelPatch is present */
+  if (!detect_kernelpatch ())
+  {
+    g_mutex_unlock (&shadow_mutex);
+    return FALSE;
+  }
+
+  /* Verify yszint-stealth KPM is loaded and responding */
+  memset (out_buf, 0, sizeof (out_buf));
+  result = kpm_ctl0 ("status", out_buf, CTL0_OUT_SIZE);
+  if (!result)
+  {
+    g_mutex_unlock (&shadow_mutex);
+    return FALSE;
+  }
+
+  shadow_enabled = TRUE;
+
+  g_mutex_unlock (&shadow_mutex);
+
+  return TRUE;
+}
+
+void
+gum_yszint_shadow_deinit (void)
+{
+  g_mutex_lock (&shadow_mutex);
+
+  g_free (shadow_superkey);
+  shadow_superkey = NULL;
+  shadow_enabled = FALSE;
+  shadow_initialized = FALSE;
+
+  g_mutex_unlock (&shadow_mutex);
+}
+
+gboolean
+gum_yszint_shadow_is_enabled (void)
+{
+  gboolean result;
+
+  g_mutex_lock (&shadow_mutex);
+  result = shadow_enabled;
+  g_mutex_unlock (&shadow_mutex);
+
+  return result;
+}
+
+gboolean
+gum_yszint_shadow_register (gpointer address,
+                            const guint8 * original_bytes,
+                            guint length)
+{
+  gchar * hex;
+  gchar * command;
+  gboolean result;
+  gchar out_buf[CTL0_OUT_SIZE];
+
+  if (original_bytes == NULL || length == 0)
+    return FALSE;
+
+  g_mutex_lock (&shadow_mutex);
+
+  if (!shadow_enabled)
+  {
+    g_mutex_unlock (&shadow_mutex);
+    return FALSE;
+  }
+
+  hex = bytes_to_hex (original_bytes, length);
+  command = g_strdup_printf ("shadow+=%lx,%u,%s",
+      (unsigned long) (guintptr) address,
+      (unsigned int) length,
+      hex);
+
+  memset (out_buf, 0, sizeof (out_buf));
+  result = kpm_ctl0 (command, out_buf, CTL0_OUT_SIZE);
+
+  g_free (command);
+  g_free (hex);
+
+  g_mutex_unlock (&shadow_mutex);
+
+  return result;
+}
+
+gboolean
+gum_yszint_shadow_unregister (gpointer address)
+{
+  gchar * command;
+  gboolean result;
+  gchar out_buf[CTL0_OUT_SIZE];
+
+  g_mutex_lock (&shadow_mutex);
+
+  if (!shadow_enabled)
+  {
+    g_mutex_unlock (&shadow_mutex);
+    return FALSE;
+  }
+
+  command = g_strdup_printf ("shadow-=%lx",
+      (unsigned long) (guintptr) address);
+
+  memset (out_buf, 0, sizeof (out_buf));
+  result = kpm_ctl0 (command, out_buf, CTL0_OUT_SIZE);
+
+  g_free (command);
+
+  g_mutex_unlock (&shadow_mutex);
+
+  return result;
+}
+
+#else /* !HAVE_LINUX */
+
+/* Stub implementation for non-Linux platforms */
+
+gboolean
+gum_yszint_shadow_init (const gchar * superkey)
+{
+  (void) superkey;
+  return FALSE;
+}
+
+void
+gum_yszint_shadow_deinit (void)
+{
+}
+
+gboolean
+gum_yszint_shadow_is_enabled (void)
+{
+  return FALSE;
+}
+
+gboolean
+gum_yszint_shadow_register (gpointer address,
+                            const guint8 * original_bytes,
+                            guint length)
+{
+  (void) address;
+  (void) original_bytes;
+  (void) length;
+  return FALSE;
+}
+
+gboolean
+gum_yszint_shadow_unregister (gpointer address)
+{
+  (void) address;
+  return FALSE;
+}
+
+#endif /* HAVE_LINUX */
diff --git a/gum/gumyszintshadow.h b/gum/gumyszintshadow.h
new file mode 100644
index 00000000..3d96aa17
--- /dev/null
+++ b/gum/gumyszintshadow.h
@@ -0,0 +1,77 @@
+/*
+ * yszint Shadow Table Integration — v2
+ * Copyright (C) 2026 yszint. All Rights Reserved.
+ *
+ * Communicates directly with KernelPatch via syscall(45) to register
+ * shadow memory entries with the yszint-stealth KPM. When integrity
+ * checkers read hooked code via /proc/[pid]/mem, the KPM returns the
+ * original pre-hook bytes.
+ *
+ * v2 improvements over v1:
+ *   - Direct supercall (no fork/exec per registration)
+ *   - Thread-safe with mutex protection
+ *   - Proper error reporting
+ *   - Version auto-detection
+ */
+
+#ifndef __GUM_YSZINT_SHADOW_H__
+#define __GUM_YSZINT_SHADOW_H__
+
+#include <glib.h>
+
+G_BEGIN_DECLS
+
+/**
+ * gum_yszint_shadow_init:
+ * @superkey: KernelPatch superkey string (required)
+ *
+ * Initialize shadow integration with yszint-stealth KPM.
+ * Verifies KernelPatch presence via supercall and checks that the KPM
+ * is loaded. Safe to call multiple times (re-initializes with new key).
+ *
+ * Returns: TRUE if KPM is reachable and shadow registration is available.
+ */
+gboolean gum_yszint_shadow_init (const gchar * superkey);
+
+/**
+ * gum_yszint_shadow_deinit:
+ *
+ * Cleanup shadow integration. Frees stored superkey.
+ */
+void gum_yszint_shadow_deinit (void);
+
+/**
+ * gum_yszint_shadow_is_enabled:
+ *
+ * Returns: TRUE if shadow registration is available.
+ */
+gboolean gum_yszint_shadow_is_enabled (void);
+
+/**
+ * gum_yszint_shadow_register:
+ * @address: Virtual address of the hooked region in the target process
+ * @original_bytes: The original bytes before the hook overwrote them
+ * @length: Number of bytes
+ *
+ * Register a shadow entry. When /proc/[pid]/mem is read at @address,
+ * the KPM will return @original_bytes instead of the actual (hooked) code.
+ *
+ * Returns: TRUE on success, FALSE on failure (KPM not available or
+ *          command rejected).
+ */
+gboolean gum_yszint_shadow_register (gpointer address,
+    const guint8 * original_bytes, guint length);
+
+/**
+ * gum_yszint_shadow_unregister:
+ * @address: Virtual address to remove from shadow table
+ *
+ * Remove a previously registered shadow entry.
+ *
+ * Returns: TRUE on success, FALSE on failure.
+ */
+gboolean gum_yszint_shadow_unregister (gpointer address);
+
+G_END_DECLS
+
+#endif /* __GUM_YSZINT_SHADOW_H__ */
